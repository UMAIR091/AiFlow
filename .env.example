# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Personal Access Token — only needed to run DB migrations (scripts/migrate.mjs)
# Get one at https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=sbp_your-personal-access-token

# Anthropic / Claude API
ANTHROPIC_API_KEY=sk-ant-your-key-here

# n8n (optional)
N8N_BASE_URL=https://your-n8n-instance.com
N8N_API_KEY=your-n8n-api-key

# Make.com (optional)
MAKE_API_KEY=your-make-api-key
MAKE_TEAM_ID=your-team-id

# Resend — real email sending (free at resend.com, no OAuth needed)
# Get key at: https://resend.com/api-keys
RESEND_API_KEY=re_your-resend-key
RESEND_FROM_EMAIL=AutoFlow <noreply@yourdomain.com>

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
